{
  "name": "lda",
  "version": "2.0.0",
  "private": true,
  "type": "module",
 "homepage": "https://ld.kavispires.com",
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-store": "^0.11.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "antd": "^6.6.7",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "react-use": "^17.6.1",
    "react-youtube": "^10.1.0",
    "recharts": "^3.10.1",
    "sass": "^1.106.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-svgr": "^5.2.0",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:the-search": "node --test scripts/the-search.test.mjs",
    "serve": "vite preview",
    "format": "biome check --write --no-errors-on-unmatched",
    "lint": "biome check --staged --write --no-errors-on-unmatched",
    "eject": "react-scripts eject",
    "prepare": "husky",
    "clean": "rm -rf node_modules && yarn cache clean",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d build",
    "update-commit": "td amend-commit-date"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "biome check --staged --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/youtube-player": "^5.5.11",
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "vite-plugin-checker": "^0.13.0"
  }
}
